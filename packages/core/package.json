{
  "name": "@a11yagent/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./net": {
      "types": "./src/net/index.ts",
      "default": "./dist/net/index.js"
    },
    "./scanner": {
      "types": "./src/scanner/index.ts",
      "default": "./dist/scanner/index.js"
    },
    "./llm": {
      "types": "./src/llm/index.ts",
      "default": "./dist/llm/index.js"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "default": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "openai": "7.32.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
