    { "id": "contact-email-label", "page": "contact.html", "selector": "input[name=email]", "expected_rule": "label", "fixable": true, "notes": "Email input with no label and no placeholder." },
    { "id": "contact-message-label", "page": "contact.html", "selector": "textarea[name=message]", "expected_rule": "label", "fixable": true, "notes": "Message textarea with no label." },
    { "id": "contact-topic-aria-value", "page": "contact.html", "selector": "#topic", "expected_rule": "aria-valid-attr-value", "fixable": true, "notes": "aria-required=\"yes\" is not a valid value." },
    { "id": "contact-hint-contrast", "page": "contact.html", "selector": ".hint", "expected_rule": "color-contrast", "fixable": true, "notes": "Low-contrast form hint." },
