    { "id": "order-back-link-name", "page": "order.html", "selector": "a.back", "expected_rule": "link-name", "fixable": true, "notes": "Icon-only back link with no text." },
    { "id": "order-pickup-aria-value", "page": "order.html", "selector": ".pickup-toggle", "expected_rule": "aria-valid-attr-value", "fixable": true, "notes": "aria-expanded=\"open\" is not a valid value." },
