{
  "version": 1,
  "control_pages": ["accessible.html"],
  "issues": [
    { "id": "index-hero-alt", "page": "index.html", "selector": "img.hero", "expected_rule": "image-alt", "fixable": true, "notes": "Hero image with no alt attribute." },
