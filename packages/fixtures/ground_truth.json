    { "id": "menu-allergen-contrast", "page": "menu.html", "selector": ".allergen-note", "expected_rule": "color-contrast", "fixable": true, "notes": "Small low-contrast allergen note." },
    { "id": "menu-add-box-unreachable", "page": "menu.html", "selector": "div.card.add-box", "expected_rule": "a11y-unreachable", "fixable": false, "notes": "role=button div without tabindex." },

    { "id": "about-document-title", "page": "about.html", "selector": "html", "expected_rule": "document-title", "fixable": true, "notes": "No title element." },
    { "id": "about-team-alt-filename", "page": "about.html", "selector": "img.team-photo", "expected_rule": "a11y-alt-quality", "fixable": true, "notes": "Alt is a file name (team_photo_03.jpg)." },
    { "id": "about-cookie-alt-generic", "page": "about.html", "selector": "img.cookie-photo", "expected_rule": "a11y-alt-quality", "fixable": true, "notes": "Alt is the generic word \"image\"." },
    { "id": "about-empty-heading", "page": "about.html", "selector": "h2.section-title", "expected_rule": "empty-heading", "fixable": false, "notes": "h2 with no text content." },
    { "id": "about-duplicate-aria-id", "page": "about.html", "selector": "#hours-title", "expected_rule": "duplicate-id-aria", "fixable": false, "notes": "Two elements share the id used by aria-labelledby. axe reports this as incomplete (D13)." },
    { "id": "about-social-link-name", "page": "about.html", "selector": "a.social", "expected_rule": "link-name", "fixable": true, "notes": "Icon-only social link with no text." },

