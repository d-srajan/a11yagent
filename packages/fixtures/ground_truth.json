    { "id": "index-cart-button-name", "page": "index.html", "selector": "button.cart", "expected_rule": "button-name", "fixable": true, "notes": "Icon-only cart button with no accessible name." },
    { "id": "index-order-now-focus", "page": "index.html", "selector": "a.order-now", "expected_rule": "a11y-focus-visible", "fixable": true, "notes": "outline: none with no replacement focus style." },
    { "id": "index-special-card-unreachable", "page": "index.html", "selector": "div.card.special", "expected_rule": "a11y-unreachable", "fixable": false, "notes": "Clickable div with an onclick handler and no tabindex." },

    { "id": "menu-html-lang", "page": "menu.html", "selector": "html", "expected_rule": "html-has-lang", "fixable": true, "notes": "No lang attribute on the html element." },
