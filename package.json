{
  "name": "a11yagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "fixtures:serve": "pnpm -s --filter @a11yagent/fixtures... build && node packages/fixtures/dist/serve.js",
    "scan": "pnpm -s --filter @a11yagent/worker... build && node --enable-source-maps apps/worker/dist/cli.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
