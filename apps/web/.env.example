# Copy to apps/web/.env.local for `pnpm --filter @a11yagent/web dev`; on Vercel set
# these in Project Settings -> Environment Variables. Never commit the real file.
# Never prefix a secret with NEXT_PUBLIC_: those values are shipped to the browser.

# Supabase: Project Settings -> API. Server only (route handlers, server components).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
# For local development use Cloudflare's published dummy keys
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   site key 1x00000000000000000000AA (always passes)
#   secret   1x0000000000000000000000000000000AA (accepts only the dummy token XXXX.DUMMY.TOKEN.XXXX)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-site-key
TURNSTILE_SECRET_KEY=replace-with-your-secret-key

# Random, 32+ characters, e.g. `openssl rand -hex 32`. Changing it resets every
# IP's daily count (old hashes no longer match).
IP_HASH_SALT=replace-with-32-plus-random-characters

# Optional (defaults shown)
SCANS_PER_IP_PER_DAY=5
# Kill switch: false shows a maintenance message and the API refuses new scans.
SCANS_ENABLED=true
