{
  "name": "@a11yagent/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "pnpm --filter @a11yagent/core build && pnpm build && node --env-file=.env --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@a11yagent/core": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
