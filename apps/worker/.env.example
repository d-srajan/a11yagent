# Copy to apps/worker/.env and fill in. Never commit the real .env.
NODE_ENV=development

# Supabase: Project Settings -> API. The service role key bypasses RLS: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional (defaults shown)
PORT=8080
POLL_INTERVAL_MS=2000
LOG_LEVEL=info

# Evals and local development only: lets the scanner reach exactly 127.0.0.1.
# The worker refuses to start with this set when NODE_ENV=production.
ALLOW_LOCAL_TARGETS=false

# --- LLM providers (Phase 3) ---------------------------------------------
# Tried in this order; a provider missing its key, base URL or text model is
# skipped with a warning. Vision calls skip providers with no vision model.
LLM_PROVIDERS=gemini,groq,openrouter

# Model IDs change often on free tiers. These were checked against each
# provider's docs on 2026-10-27; re-check before relying on them.
# Gemini (Google AI Studio key): https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/docs/models (Llama 3.3 / Llama 4 Scout were
# retired in 2026). No vision model configured: Groq is a text fallback only.
GROQ_API_KEY=replace-with-your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=

# OpenRouter free models (":free" suffix): https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# Optional, any provider: true sends OpenRouter's reasoning {enabled:false} so a
# reasoning model answers directly. Much faster and fewer tokens (DECISIONS.md D29).
OPENROUTER_DISABLE_REASONING=false

# --- Cost controls (defaults shown) ---------------------------------------
MAX_LLM_CALLS_PER_SCAN=25
MAX_LLM_OUTPUT_TOKENS_PER_SCAN=20000
MAX_VISION_IMAGES=8
# Global, per UTC day, counted from agent_steps (when Supabase is configured).
DAILY_LLM_CALL_CAP=1000
LLM_TIMEOUT_MS=20000
